{
	// Copied verbatim into build/ by SvelteKit's static-file handling (like
	// CNAME, robots.txt in this same directory). Cloudflare's Workers Builds
	// "Path"/deploy-cwd setting (apps/micropolis/build) runs `npx wrangler
	// deploy` from inside this directory, so `main`/`assets.directory` are
	// relative to here -- this file sits right next to what it describes.
	//
	// worker.js explicitly routes /play/* to the 200.html SPA shell. Plain
	// `assets.not_found_handling: "single-page-application"` was NOT used:
	// this site is mostly prerendered static pages (index.html is a real
	// landing page, not an app shell), so a blanket SPA fallback would serve
	// the landing page instead of the game shell for /play/* paths, and
	// would also swallow genuine 404s everywhere else on the site.
	"name": "hdmicropolis",
	"compatibility_date": "2025-01-01",
	"main": "worker.js",
	"assets": {
		"directory": "./",
		"binding": "ASSETS"
	}
}
