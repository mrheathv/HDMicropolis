{
	// Copied verbatim into build/ by SvelteKit's static-file handling (like
	// robots.txt in this same directory). Cloudflare's Workers Builds
	// "Path"/deploy-cwd setting (apps/micropolis/build) runs `npx wrangler
	// deploy` from inside this directory, so `assets.directory` is relative
	// to here -- this file sits right next to what it describes.
	//
	// No custom Worker script (`main`) on purpose: a hand-rolled fetch
	// handler here went through several rounds of bugs (a redirect loop,
	// then real JS/CSS assets being served back as text/html) trying to
	// reimplement SPA-fallback routing by hand. Cloudflare's own
	// not_found_handling: "single-page-application" does exactly this
	// natively -- serves the top-level index.html for any path that isn't
	// a literal asset -- and is what adapter-static's `fallback: 'index.html'`
	// (svelte.config.js) is specifically named to match.
	"name": "hdmicropolis",
	"compatibility_date": "2025-01-01",
	"assets": {
		"directory": "./",
		"not_found_handling": "single-page-application"
	}
}
